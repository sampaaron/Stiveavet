{
  "name": "stivea-vet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/start-standalone.sh",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "tsx --env-file-if-exists=.env tests/e2e/prepare-database.mts && playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed.mts",
    "demo:emails": "tsx --env-file-if-exists=.env scripts/demo-emails.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "docs:permissions": "tsx scripts/docs-permissions.mts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  }
}
