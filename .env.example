# Copier vers .env (jamais versionné). Valeurs locales uniquement, aucune donnée réelle.
# Aucune clé WhatsApp, dr.veto, Stripe ou IA n'est utilisée à ce stade.

APP_ENV=local
APP_URL=http://localhost:3000

# PostgreSQL local (Docker Compose). Choisir un mot de passe local quelconque.
POSTGRES_USER=stivea
POSTGRES_PASSWORD=
POSTGRES_DB=stivea
DATABASE_URL=postgres://stivea:CHANGER_ICI@localhost:5432/stivea

# Mailpit (e-mails locaux, interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
