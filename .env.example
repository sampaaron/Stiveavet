# Copier vers .env (jamais versionné). Valeurs locales uniquement, aucune donnée réelle.
# Aucune clé dr.veto ou Stripe n'est utilisée à ce stade.

APP_ENV=local
APP_URL=http://localhost:3000

# PostgreSQL local (Docker Compose). Trois mots de passe locaux quelconques et distincts :
# - superutilisateur : uniquement pour créer les rôles et les bases de test ;
# - stivea_migrator  : propriétaire du schéma, applique les migrations ;
# - stivea_app       : rôle de l'application, soumis à l'isolation par cabinet (RLS).
POSTGRES_ADMIN_PASSWORD=
STIVEA_MIGRATOR_PASSWORD=
STIVEA_APP_PASSWORD=

MIGRATOR_DATABASE_URL=postgres://stivea_migrator:CHANGER_ICI@localhost:5432/stivea
DATABASE_URL=postgres://stivea_app:CHANGER_ICI@localhost:5432/stivea

# Tests d'intégration : superutilisateur d'une instance jetable (crée puis supprime une base par exécution).
TEST_DATABASE_ADMIN_URL=postgres://postgres:CHANGER_ICI@localhost:5432/postgres

# Mailpit (e-mails locaux, interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# « true » uniquement derrière un répartiteur de charge qui écrit X-Forwarded-For.
TRUST_PROXY=false

# Photos, vocaux et captures d'agenda (ADR 0019) : dossier local privé, chemin absolu.
# Sans valeur : .data/objets dans le dossier du projet (jamais versionné).
# OBJECT_STORAGE_DIR=
# Clé des liens de lecture signés (32 caractères au moins). En local, facultative : une clé
# aléatoire est tirée à chaque démarrage. Exemple : openssl rand -base64 48
# FILE_LINK_SECRET=

# WhatsApp (ADR 0024). « simulated » en local seulement ; « cloud_api » exige toutes les
# valeurs ci-dessous, prises dans le gestionnaire de secrets, jamais dans ce fichier versionné.
WHATSAPP_PROVIDER=simulated
# Clés de chiffrement des jetons des cabinets : « id:base64 de 32 octets », séparées par des
# virgules ; la première chiffre, toutes déchiffrent. Exemple : k1:$(openssl rand -base64 32)
# SECRETS_ENCRYPTION_KEYS=
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Passerelle IA (ADR 0026). « simulated » en local seulement ; « scaleway » ou « mistral »
# exigent la clé et les trois modèles, pris dans le gestionnaire de secrets.
AI_PROVIDER=simulated
# AI_API_KEY=
# AI_BASE_URL=
# AI_TEXT_MODEL=
# AI_VISION_MODEL=
# AI_TRANSCRIPTION_MODEL=
